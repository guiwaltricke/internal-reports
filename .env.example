# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides for CI/CD, GitHub, and production)
# Note: do not include quotation marks in values
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=autenticacaopaineladm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=autenticacaopaineladm
VITE_FIREBASE_STORAGE_BUCKET=autenticacaopaineladm.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=658657866380
VITE_FIREBASE_APP_ID=1:658657866380:web:7a63bf9cd8391b6b83c1a9
VITE_FIREBASE_DATABASE_ID=ai-studio-hostreporthosped-a80189e1-dc1a-4bd4-bfbb-0ff49e7821cb

# =================== Servidor / Firebase Admin (obrigatório na Vercel) ===================
# O servidor Express (api/index.ts) lê e grava no MESMO Firestore que o front-end,
# usando o Admin SDK. Sem estas variáveis as rotas /api/* e /r/* respondem 500.
#
# Opção A — o JSON completo do service account, cru ou em base64 (uma variável só):
FIREBASE_SERVICE_ACCOUNT=
#
# Opção B — os três campos separados (mais prático de colar no painel da Vercel).
# Em FIREBASE_PRIVATE_KEY as quebras de linha podem vir como \n literais.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ID do banco nomeado do Firestore. Use o mesmo valor de VITE_FIREBASE_DATABASE_ID.
# Deixe vazio para usar o banco "(default)" do projeto.
FIREBASE_DATABASE_ID=

# Cria a conta de demonstração guilherme@nextfit.com.br no primeiro boot.
# Desligado por padrão: a senha padrão é pública. Ligue apenas em ambientes de teste.
SEED_DEFAULT_USER=false
SEED_DEFAULT_USER_PASSWORD=
