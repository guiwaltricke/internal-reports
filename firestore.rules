rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isNextFitEmail() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*@nextfit[.]com[.]br$') ||
        request.auth.token.email == 'guilherme@nextfit.com.br'
      );
    }
    function isOwner(reportData) {
      return isAuthenticated() && (
        reportData.ownerId == request.auth.uid ||
        reportData.authorId == request.auth.uid ||
        reportData.ownerEmail == request.auth.token.email ||
        reportData.authorEmail == request.auth.token.email
      );
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isNextFitEmail());
    }

    match /reports/{reportId} {
      allow read: if isNextFitEmail()
                  || resource.data.security.accessType == 'public_link'
                  || (isAuthenticated() && resource.data.security.allowedEmails.hasAny([request.auth.token.email]))
                  || isOwner(resource.data);
      allow create: if isNextFitEmail() || (isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid || 
        request.resource.data.authorId == request.auth.uid
      ));
      allow update, delete: if isNextFitEmail() || isOwner(resource.data);
    }
  }
}
