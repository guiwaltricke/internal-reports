rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isNextFitEmail() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*@nextfit[.]com[.]br$') ||
        request.auth.token.email == 'guilherme@nextfit.com.br'
      );
    }
    function isOwner(reportData) {
      return isAuthenticated() && (
        reportData.ownerId == request.auth.uid ||
        reportData.authorId == request.auth.uid ||
        reportData.ownerEmail == request.auth.token.email ||
        reportData.authorEmail == request.auth.token.email
      );
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isNextFitEmail());
    }

    // Server-only collections, written exclusively by the Firebase Admin SDK in
    // api/index.ts. serverUsers holds password hashes and salts and serverSessions
    // holds live auth tokens, so no client may ever read them. reportContents holds
    // the chunked HTML of reports too large to inline, gated by the same server.
    // The Admin SDK bypasses these rules.
    match /serverUsers/{userId} {
      allow read, write: if false;
    }

    match /serverSessions/{token} {
      allow read, write: if false;
    }

    match /reportContents/{document=**} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read: if isNextFitEmail()
                  || resource.data.security.accessType == 'public_link'
                  || (isAuthenticated() && resource.data.security.allowedEmails.hasAny([request.auth.token.email]))
                  || isOwner(resource.data);
      allow create: if isNextFitEmail() || (isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid || 
        request.resource.data.authorId == request.auth.uid
      ));
      allow update, delete: if isNextFitEmail() || isOwner(resource.data);
    }
  }
}
